# --- API Swfast v5 ---------------------------------------------------------
SWFAST_API_KEY=cole_a_chave_aqui
SWFAST_URL=https://analytics-api.swfast.com.br/v5

# --- Janela de coleta ------------------------------------------------------
# Máximo aceito pela API: 7.
DIAS_POR_JANELA=7

# --- Ritmo da execução -----------------------------------------------------
# Segundos de pausa entre uma fonte e a próxima.
INTERVALO_ENTRE_CHAMADAS=5
TIMEOUT_SEGUNDOS=120
TENTATIVAS=3
ESPERA_INICIAL_RETENTATIVA=2

# --- PostgreSQL (etapa de carga) ------------------------------------------
# Rodando no Windows contra o container: 127.0.0.1 e a porta publicada
# (o container publica só em IPv4; "localhost" tenta antes o ::1 e espera 10s).
# Quando a aplicação também estiver no docker-compose: o nome do serviço.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=swfast
POSTGRES_USER=swfast
POSTGRES_PASSWORD=troque_a_senha

# --- Saída -----------------------------------------------------------------
# Pasta dos manifestos (_manifesto) e dos logs (_logs).
DIRETORIO_DADOS=data

# --- Filtros de loja (só valem para lojas centrais) ------------------------
# Códigos separados por vírgula. Deixe vazio para não filtrar.
LISTA_DE_LOJAS=
USAR_LOJA_ID_EXTERNO=true
