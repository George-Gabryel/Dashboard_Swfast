# --- API Swfast v5 ---------------------------------------------------------
SWFAST_API_KEY=cole_a_chave_aqui
SWFAST_URL=https://analytics-api.swfast.com.br/v5

# --- Janela de coleta ------------------------------------------------------
# Máximo aceito pela API: 7.
DIAS_POR_JANELA=7

# --- Ritmo da execução -----------------------------------------------------
# Segundos de pausa entre uma fonte e a próxima.
INTERVALO_ENTRE_CHAMADAS=5
TIMEOUT_SEGUNDOS=120
TENTATIVAS=3
ESPERA_INICIAL_RETENTATIVA=2

# --- Saída -----------------------------------------------------------------
DIRETORIO_DADOS=data

# --- Filtros de loja (só valem para lojas centrais) ------------------------
# Códigos separados por vírgula. Deixe vazio para não filtrar.
LISTA_DE_LOJAS=
USAR_LOJA_ID_EXTERNO=true
