# --- Metabase (dashboard) --------------------------------------------------
# Copie para .env.meta e preencha. Só o Metabase e o `docker compose run --rm
# instalar-dashboard` leem este arquivo; o ETL não.
# Administrador do Metabase (criado na instalação; é com ele que se edita o dashboard).
METABASE_ADMIN_EMAIL=admin@exemplo.com.br
METABASE_ADMIN_SENHA=troque_a_senha_admin
# Banco interno do Metabase ("metabase", no mesmo Postgres) e o dono dele.
MB_DB_USER=metabase_app
MB_DB_PASS=troque_a_senha_app
# Usuário só de leitura com que o Metabase consulta o banco swfast.
METABASE_LEITOR_SENHA=troque_a_senha_leitor
# Endereço do Metabase visto de dentro do container do ETL.
METABASE_URL=http://metabase:3000
