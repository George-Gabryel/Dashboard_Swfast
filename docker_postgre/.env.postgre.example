# Copie para .env.postgre e preencha. Sem espaços em volta do "=".
# Nome do banco, usuário e senha — os mesmos POSTGRES_DB, POSTGRES_USER e
# POSTGRES_PASSWORD do .env do ETL, na raiz do repositório.
# Só valem na primeira subida, quando o volume ainda está vazio.
POSTGRES_DB=swfast
POSTGRES_USER=swfast
POSTGRES_PASSWORD=troque_a_senha
